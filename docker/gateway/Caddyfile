# Gateway Napay v2. Opzioni globali e default qui; i siti di ogni app in conf.d/<app>.caddy.
{
    local_certs
    admin off
}

(no_btcpay_backend) {
    @btcpay_backend remote_ip 10.252.0.0/24
    handle @btcpay_backend {
        abort
    }
}

:80 {
    import no_btcpay_backend
    handle {
        redir https://napay.local{uri} permanent
    }
}

import conf.d/*.caddy
