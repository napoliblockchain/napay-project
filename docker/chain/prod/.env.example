# Copiare in .env (chmod 600). Nessun segreto qui: le chiavi restano nel volume chain_data.
POA_DOMAIN=poa.example.org
ACME_EMAIL=admin@example.org
# IP pubblici ammessi all'RPC, separati da spazio
RPC_ALLOWED_IPS=192.0.2.10 192.0.2.20
CHAIN_ID=2118
# secondi tra un blocco e l'altro (letto solo alla creazione del genesis)
CHAIN_BLOCK_PERIOD=5
BESU_HEAP=1g
BESU_MEM_LIMIT=1536m
