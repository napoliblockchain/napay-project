# Copiare in docker/btcpay-regtest/.env (ignorato da git) oppure esportare le variabili.
# Cartella privata assoluta, fuori dal repository; local.sh la crea 0700 con .gitignore e regtest.env 0600.
BTCPAY_LOCAL_STATE=/var/www/documents/progetti/napoliblockchain/btcpay/ambiente-locale
# Rete interna condivisa con il gateway (integrazione a cura del master)
BTCPAY_EDGE_NETWORK=btcpay_regtest_edge
