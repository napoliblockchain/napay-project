# Gateway proposto per B0 (vedi B0-HANDOFF): CA locale, snippet che rifiuta il backend BTCPay.
# Nel gateway reale la subnet e' 10.252.0.0/24; qui arriva da EDGE_SUBNET per il test.
{
    local_certs
    admin off
}

# handle (non abort semplice): viene valutato prima dei blocchi handle dei siti, che altrimenti lo scavalcano
(no_btcpay_backend) {
    @btcpay_backend remote_ip {$EDGE_SUBNET}
    handle @btcpay_backend {
        abort
    }
}

https://btcpay.local {
    import no_btcpay_backend
    reverse_proxy btcpay-regtest:49392
}

# controfigura di un altro sito del gateway (napay.local, wallet.local, pos)
https://napay.local {
    import no_btcpay_backend
    respond "napay-site"
}

# controfigura con la struttura di wallet.caddy (blocchi handle)
https://wallet.local {
    import no_btcpay_backend
    handle /ws-notify {
        respond "wallet-ws"
    }
    handle {
        respond "wallet-site"
    }
}
