# Core
COMPOSE_PROJECT_NAME=napay_v2
APP_ENV=dev

# Gateway locale su 80/443 solo loopback (https://wallet.local, https://napay.local);
# altre porte non standard (anti-conflict baseline)
GATEWAY_BIND=127.0.0.1
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
ADMINER_HOST_PORT=18081
MAILHOG_UI_HOST_PORT=18025
MAILHOG_SMTP_HOST_PORT=11025
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
WS_NOTIFY_HOST_PORT=18110

# Database defaults (change in real env files / secrets manager)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=napay
MYSQL_USER=napay_user
MYSQL_PASSWORD=change-me-user
WEBSOCKET_URL=/ws-notify
WEBSOCKET_URL_LOCALHOST=/ws-notify
NOTIFY_INTERNAL_SECRET=change-me-secret
NOTIFY_ALLOWED_ORIGINS=https://wallet.local
