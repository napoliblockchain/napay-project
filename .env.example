# Core
COMPOSE_PROJECT_NAME=napay_v2
APP_ENV=dev

# Gateway locale su 80/443 solo loopback (https://wallet.local, https://napay.local);
# con un proxy SNI locale che tiene 80/443 si possono usare porte proprie (es. 30480/30443).
# Altre porte non standard (anti-conflict baseline)
GATEWAY_BIND=127.0.0.1
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
ADMINER_HOST_PORT=18081
MAILHOG_UI_HOST_PORT=18025
MAILHOG_SMTP_HOST_PORT=11025
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
WS_NOTIFY_HOST_PORT=18110

# Database defaults (change in real env files / secrets manager)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=napay
MYSQL_USER=napay_user
MYSQL_PASSWORD=change-me-user
WEBSOCKET_URL=/ws-notify
WEBSOCKET_URL_LOCALHOST=/ws-notify
NOTIFY_INTERNAL_SECRET=change-me-secret
NOTIFY_ALLOWED_ORIGINS=https://wallet.local

# Cartella privata della sandbox napay (local.env, password, CA, chiave client POS), fuori dai repository.
# Vuota: ~/.local/share/napay/browser-local
NAPAY_LOCAL_STATE=

# --- Wallet in produzione (deploy-wallet.sh; nella sandbox i default puntano alla chain di sviluppo) ---
# Rete e token unici del wallet (SIP-032), mai scelti dagli utenti
WALLET_CHAIN_RPC_URL=
WALLET_CHAIN_ID=
WALLET_CHAIN_NAME=
WALLET_CHAIN_SYMBOL=ETH
WALLET_CHAIN_ZERO_GAS=1
WALLET_CHAIN_EXPLORER_URL=
WALLET_TTS_TOKEN_ADDRESS=
WALLET_TTS_TOKEN_NAME=TTS
WALLET_TTS_TOKEN_SYMBOL=TTS
WALLET_TTS_TOKEN_DECIMALS=2
# segreti dell'indicizzatore e dei ticket /events: file in una cartella privata (0700) fuori dai repository
WALLET_INDEXER_SECRET_FILE=
WALLET_REALTIME_KEY_FILE=
